# Porta onde o gateway HTTP/WebSocket vai rodar
PORT=3333

# Pasta onde a sessão do Baileys (credenciais do WhatsApp) é salva.
# IMPORTANTE: faça backup/persista essa pasta em disco persistente (não em containers efêmeros),
# senão você perde a sessão e precisa escanear o QR Code de novo a cada deploy.
AUTH_FOLDER=./auth_session

# (Opcional) Intervalo, em ms, entre a reconexão de cada sessão já pareada
# no boot do servidor (SessionManager.startAllExisting, src/sessions.js).
# Existe pra evitar abrir dezenas de conexões WebSocket pro WhatsApp no
# mesmo instante a cada redeploy — esse pico já foi identificado derrubando
# sessões reais (o WhatsApp trata como padrão de login em massa). Padrão:
# 15000 (15s) — testado com 4000 (4s) em 2026-08-03 e ainda assim 5 de 11
# sessões caíram no mesmo boot, então o valor subiu bastante.
SESSION_STAGGER_MS=15000

# (Opcional) Webhook de entrada do Bitrix24 — usado para:
#   1. registrar mensagens na timeline do negócio (crm.timeline.comment.add);
#   2. criar contato + negócio no CRM a cada lead de LP (crm.contact.add/crm.deal.add).
# REQUISITO: o webhook precisa da permissão CRM. Sem isso, os itens acima
# degradam graciosamente (nada quebra, mas nada aparece no Bitrix).
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/WEBHOOK_CODE/
BITRIX_WEBHOOK_URL=

# (Opcional) Webhook de entrada DEDICADO — separado do BITRIX_WEBHOOK_URL
# acima de propósito, pra poder revogar/trocar um sem afetar o outro — só
# pra resolver a hierarquia de departamentos (department.get + user.get) e
# dar delegação AUTOMÁTICA de acesso: o gestor de um departamento passa a
# enxergar as instâncias de WhatsApp de todo subordinado (cascateando
# sub-departamentos), sem precisar compartilhar manualmente uma por uma
# (ver instance_delegates/"Compartilhar acesso" em /instances.html).
# REQUISITO: o webhook precisa da permissão "Usuários" (departamentos).
# Sem esta variável, a feature fica silenciosamente inativa — continua
# funcionando só a delegação manual de sempre.
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/WEBHOOK_CODE/
BITRIX_HR_WEBHOOK_URL=

# (Opcional) Por quantas horas o cache da hierarquia de departamentos
# (tabela hierarchy_subordinates) fica válido antes de recalcular contra o
# Bitrix de novo. Padrão: 6.
HIERARCHY_CACHE_TTL_HOURS=6

# (Opcional) Pipeline ÚNICO e compartilhado onde TODAS as LPs lançam
# negócio — cada lead vai pra cá, atribuído ao SDR dono da LP
# (ASSIGNED_BY_ID). A visibilidade "cada SDR só vê o próprio lead" é
# resolvida por permissão nativa do Bitrix (CRM > Permissões, escopo
# "somente próprios"), configurada manualmente no portal — não por
# pipeline separado nem por nada que este app controle via API.
# É o número que aparece depois de /category/ na URL do kanban:
# https://SEU-DOMINIO.bitrix24.com.br/crm/deal/kanban/category/<ESTE-NUMERO>/
BITRIX_LEADS_CATEGORY_ID=

# (Opcional) Chave da API da OpenAI (platform.openai.com) — usada só pelo
# botão "Gerar com IA" ao encerrar um teste A/B em Sites (sugere o texto de
# análise a partir das métricas reais do teste). Sem ela, o botão mostra
# erro, mas o encerramento do teste continua funcionando normalmente (a
# análise pode ser escrita manualmente).
OPENAI_API_KEY=

# Lista de origens autorizadas a chamar a API (domínio do seu Bitrix24).
# Separe múltiplas origens por vírgula.
ALLOWED_ORIGINS=https://SEU-DOMINIO.bitrix24.com.br

# URL pública deste servidor (a mesma usada como "Caminho do manipulador"
# no app local do Bitrix24, ex: o endereço do ngrok). É usada na instalação
# do app para registrar a aba "WhatsApp" nos cards de Negócio (placement.bind).
# Sem isso configurado, a aba não aparece nos cards.
PUBLIC_URL=https://SEU-ENDERECO-PUBLICO

# Supabase — banco (Postgres) e storage de mídia (imagem/áudio/vídeo).
# Painel do projeto: Settings > API (URL + secret key) e Settings > Database
# (connection string, botão "Connect" no topo do dashboard).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU-SECRET-KEY

# Pooler de transação (pgbouncer) — usado pela aplicação em runtime.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sessão — usado só para rodar a migração do schema.
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:5432/postgres"

# Domínio FIXO do portal Bitrix24 (single-tenant) — usado SÓ no backend pra
# verificar de verdade o access_token do usuário contra o Bitrix real. NUNCA
# aceitar esse domínio vindo do client, senão um client malicioso poderia
# apontar pro próprio portal dele e se passar por qualquer ownerId daqui.
BITRIX_PORTAL_DOMAIN=SEU-DOMINIO.bitrix24.com.br

# member_id deste portal (o mesmo que já aparece em ownerId = member_id_userId).
# Fixo no servidor pelo mesmo motivo do domínio acima — nunca vem do client.
BITRIX_MEMBER_ID=

# Segredo pra assinar (HMAC) o token de sessão do próprio app (não é o token
# do Bitrix). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# (Opcional) validade do token do app, em horas. Padrão: 12.
AUTH_TOKEN_TTL_HOURS=12

# (Opcional) validade do token de API (gerado em /settings.html, pra uso em
# scripts/Postman/Power Query fora do navegador), em DIAS. Padrão: 90.
API_TOKEN_TTL_DAYS=90

# (Opcional) Marca exibida nas 8 páginas com sidebar — nome, subtítulo e cor
# de destaque (sobrescreve a variável CSS --gold). Se deixar em branco, cada
# página mantém o texto/cor já fixos no HTML (hoje "Durão, Almeida & Pontes").
# Pensado pra permitir reaproveitar este mesmo código pra outro cliente sem
# editar nenhum arquivo — ver GET /api/brand em src/server.js.
BRAND_NAME=
BRAND_SUBTITLE=
BRAND_COLOR=
# Usados só na coluna "Siga-nos" e no mapa de localização do rodapé da LP
# pública (public/lead-form.html) — vazio por padrão, some da tela até
# serem preenchidos (não inventa link/endereço nenhum sozinho).
BRAND_INSTAGRAM_URL=
BRAND_LINKEDIN_URL=
BRAND_ADDRESS=
