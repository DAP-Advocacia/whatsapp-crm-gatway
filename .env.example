# Porta onde o gateway HTTP/WebSocket vai rodar
PORT=3333

# Pasta onde a sessão do Baileys (credenciais do WhatsApp) é salva.
# IMPORTANTE: faça backup/persista essa pasta em disco persistente (não em containers efêmeros),
# senão você perde a sessão e precisa escanear o QR Code de novo a cada deploy.
AUTH_FOLDER=./auth_session

# (Opcional) Intervalo, em ms, entre a reconexão de cada sessão já pareada
# no boot do servidor (SessionManager.startAllExisting, src/sessions.js).
# Existe pra evitar abrir dezenas de conexões WebSocket pro WhatsApp no
# mesmo instante a cada redeploy — esse pico já foi identificado derrubando
# sessões reais (o WhatsApp trata como padrão de login em massa). Padrão:
# 15000 (15s) — testado com 4000 (4s) em 2026-08-03 e ainda assim 5 de 11
# sessões caíram no mesmo boot, então o valor subiu bastante.
SESSION_STAGGER_MS=15000

# (Opcional) Webhook de entrada do Bitrix24 — usado para:
#   1. registrar mensagens na timeline do negócio (crm.timeline.comment.add);
#   2. criar contato + negócio no CRM a cada lead de LP (crm.contact.add/crm.deal.add).
# REQUISITO: o webhook precisa da permissão CRM. Sem isso, os itens acima
# degradam graciosamente (nada quebra, mas nada aparece no Bitrix).
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/WEBHOOK_CODE/
BITRIX_WEBHOOK_URL=

# (Opcional) Webhook de entrada DEDICADO — separado do BITRIX_WEBHOOK_URL
# acima de propósito, pra poder revogar/trocar um sem afetar o outro — só
# pra resolver a hierarquia de departamentos (department.get + user.get) e
# dar delegação AUTOMÁTICA de acesso: o gestor de um departamento passa a
# enxergar as instâncias de WhatsApp de todo subordinado (cascateando
# sub-departamentos), sem precisar compartilhar manualmente uma por uma
# (ver instance_delegates/"Compartilhar acesso" em /instances.html).
# REQUISITO: o webhook precisa de DOIS escopos marcados — "Usuários
# (user)" E "Estrutura da empresa (department)". Só "Usuários" NÃO É
# suficiente: department.get falha com "requires higher privileges" sem o
# escopo "department" marcado também (descoberto testando em produção,
# 2026-08-04). Sem esta variável, a feature fica silenciosamente inativa
# — continua funcionando só a delegação manual de sempre.
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/WEBHOOK_CODE/
BITRIX_HR_WEBHOOK_URL=

# (Opcional) Por quantas horas o cache da hierarquia de departamentos
# (tabela hierarchy_subordinates) fica válido antes de recalcular contra o
# Bitrix de novo. Padrão: 6.
HIERARCHY_CACHE_TTL_HOURS=6

# (Opcional) Webhook de entrada DEDICADO ao Feed (Live Feed) do Bitrix24
# — separado do BITRIX_WEBHOOK_URL (escopo CRM) e do BITRIX_HR_WEBHOOK_URL
# (escopo user+department) de propósito, mesmo padrão dos dois: cada
# integração pode ser revogada/trocada sem afetar as outras. Usado só pra
# publicar posts no Feed nativo do Bitrix ("Para todos os colaboradores",
# ver Painel Admin > Publicar no Feed) — nunca automático, sempre disparado
# manualmente pelo super admin.
# REQUISITO: o webhook precisa dos escopos "Rede Social" E "log" (Feed/
# Log de atividades) marcados — CONFIRMADO em teste real (2026-08-25) que
# "Rede Social" sozinho NÃO basta pra log.blogpost.add, apesar do nome
# sugerir o contrário (dá insufficient_scope mesmo com a URL/token certos).
# Sem esta variável, o botão "Publicar" falha com uma mensagem clara —
# nada mais no sistema é afetado.
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/WEBHOOK_CODE/
BITRIX_FEED_WEBHOOK_URL=

# (Opcional) Pipeline ÚNICO e compartilhado onde TODOS os leads lançam
# negócio — leads de LP (formulário) E leads atendidos pelo Agente de
# IA (lead manda mensagem, com ou sem LP, ver Painel > Agente de IA)
# usam a MESMA categoria. Atribuído ao SDR dono da instância
# (ASSIGNED_BY_ID). A visibilidade "cada SDR só vê o próprio lead" é
# resolvida por permissão nativa do Bitrix (CRM > Permissões, escopo
# "somente próprios"), configurada manualmente no portal — não por
# pipeline separado nem por nada que este app controle via API.
# É o número que aparece depois de /category/ na URL do kanban:
# https://SEU-DOMINIO.bitrix24.com.br/crm/deal/kanban/category/<ESTE-NUMERO>/
BITRIX_LEADS_CATEGORY_ID=

# (Opcional) sessionId da ÚNICA instância de WhatsApp que dispara o
# gatilho automático da campanha de tráfego pago do Dr. Adriano (ver
# src/campaignTrafficTrigger.js) — toda conversa nova nessa instância
# cria negócio no pipeline 536, independente do Agente de IA estar ativo
# ou não. Formato: `${BITRIX_MEMBER_ID}_${bitrixUserId}` (instância
# Principal) ou com sufixo `__<id>` (instância secundária, ver
# /instances.html). Sem esta variável, a função não faz nada (nenhuma
# instância é afetada).
ADRIANO_CAMPAIGN_SESSION_ID=

# (Opcional) Chave da API da OpenAI (platform.openai.com) — usada só pelo
# botão "Gerar com IA" ao encerrar um teste A/B em Sites (sugere o texto de
# análise a partir das métricas reais do teste). Sem ela, o botão mostra
# erro, mas o encerramento do teste continua funcionando normalmente (a
# análise pode ser escrita manualmente).
OPENAI_API_KEY=

# Lista de origens autorizadas a chamar a API (domínio do seu Bitrix24).
# Separe múltiplas origens por vírgula.
ALLOWED_ORIGINS=https://SEU-DOMINIO.bitrix24.com.br

# URL pública deste servidor (a mesma usada como "Caminho do manipulador"
# no app local do Bitrix24, ex: o endereço do ngrok). É usada na instalação
# do app para registrar a aba "WhatsApp" nos cards de Negócio (placement.bind).
# Sem isso configurado, a aba não aparece nos cards.
PUBLIC_URL=https://SEU-ENDERECO-PUBLICO

# Supabase — banco (Postgres) e storage de mídia (imagem/áudio/vídeo).
# Painel do projeto: Settings > API (URL + secret key) e Settings > Database
# (connection string, botão "Connect" no topo do dashboard).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU-SECRET-KEY

# Pooler de transação (pgbouncer) — usado pela aplicação em runtime.
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sessão — usado só para rodar a migração do schema.
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:5432/postgres"
# Máximo de conexões simultâneas do processo com o pooler acima (ver
# src/db.js) — opcional, default 10 se não definida. Confirme o limite do
# pooler no painel do Supabase antes de subir este valor.
# DB_POOL_MAX=10

# Domínio FIXO do portal Bitrix24 (single-tenant) — usado SÓ no backend pra
# verificar de verdade o access_token do usuário contra o Bitrix real. NUNCA
# aceitar esse domínio vindo do client, senão um client malicioso poderia
# apontar pro próprio portal dele e se passar por qualquer ownerId daqui.
BITRIX_PORTAL_DOMAIN=SEU-DOMINIO.bitrix24.com.br

# member_id deste portal (o mesmo que já aparece em ownerId = member_id_userId).
# Fixo no servidor pelo mesmo motivo do domínio acima — nunca vem do client.
BITRIX_MEMBER_ID=

# Segredo pra assinar (HMAC) o token de sessão do próprio app (não é o token
# do Bitrix). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=

# (Opcional) validade do token do app, em horas. Padrão: 12.
AUTH_TOKEN_TTL_HOURS=12

# (Opcional) validade do token de API (gerado em /settings.html, pra uso em
# scripts/Postman/Power Query fora do navegador), em DIAS. Padrão: 90.
API_TOKEN_TTL_DAYS=90

# (Opcional) Nome/subtítulo da marca exibidos nas páginas com sidebar. Se
# deixar em branco, cada página mantém o texto já fixo no HTML (hoje "Durão,
# Almeida & Pontes"). Pensado pra permitir reaproveitar este mesmo código
# pra outro cliente sem editar nenhum arquivo — ver GET /api/brand em
# src/server.js. A cor de destaque (BRAND_COLOR) foi removida no redesign
# visual — a paleta do app é fixa no código (public/assets/theme.css), sem
# exceção por instalação.
BRAND_NAME=
BRAND_SUBTITLE=
# Usados só na coluna "Siga-nos" e no mapa de localização do rodapé da LP
# pública (public/lead-form.html) — vazio por propósito, some da tela até
# serem preenchidos (não inventa link/endereço nenhum sozinho).
BRAND_INSTAGRAM_URL=
BRAND_LINKEDIN_URL=
BRAND_ADDRESS=

# Lista de ownerId (formato member_id_userId, ver ownerIdFor em src/auth.js)
# com acesso ao painel admin restrito (/admin.html — quem está com o app
# aberto agora + cadastro de funcionários do Bitrix). Separe múltiplos por
# vírgula. NUNCA vem de dado enviado pelo cliente — só desta variável de
# servidor (ver src/adminAuth.js). Sem esta variável, ninguém acessa
# /admin.html nem as rotas GET /admin/* (403 pra todo mundo).
SUPER_ADMIN_OWNER_IDS=

# (Opcional) Web Push (Service Worker) — notifica o usuário mesmo com
# TODAS as abas do sistema fechadas (ver src/webpush.js, "Ativar
# notificações do sistema" nas telas com sidebar). Gere o par de chaves
# UMA VEZ com: npx web-push generate-vapid-keys — nunca gere de novo
# depois que alguém já se inscreveu, ou as subscriptions existentes param
# de funcionar. Sem estas 2 variáveis, o canal de push fica silenciosamente
# inativo (os outros canais — in-app, WhatsApp de sistema, e-mail —
# continuam funcionando normalmente, best-effort/independente).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (Opcional) Identificação exigida pela spec Web Push (RFC 8292) — um
# mailto: ou https: de contato, usado pelos provedores de push (Chrome/
# Firefox) pra saber quem procurar em caso de abuso. Padrão se vazio:
# mailto:contato@example.com (funciona, mas prefira um e-mail real seu).
VAPID_SUBJECT=mailto:SEU-EMAIL@SEU-DOMINIO.com.br

# (Opcional) Telefone fixo do escritório, incluído automaticamente em todo
# grupo criado pelo gatilho de etapa do Kanban (ver
# DEAL_GROUP_TRIGGER_TOKEN abaixo). Formato: só dígitos, com ou sem código
# do país (DDD+número sem "55" também funciona — normalizado como o resto
# do app). Sem esta variável, o grupo é criado sem este participante (não
# bloqueia a feature).
OFFICE_OWNER_PHONE=

# (Opcional) Telefone fixo do setor de Verificação, incluído automaticamente
# em todo grupo criado pelo mesmo gatilho — mesmo formato/comportamento de
# OFFICE_OWNER_PHONE acima (dígitos com ou sem "55", opcional, não bloqueia
# a feature se ausente).
VERIFICATION_SECTOR_PHONE=

# (Opcional) Segredo compartilhado que protege
# POST /api/system/deal-group-trigger — endpoint chamado por um Robô de
# Automação cadastrado na etapa do Kanban que deve criar o grupo de
# WhatsApp automático (Responsável + cliente + Gerente/Diretor responsáveis +
# OFFICE_OWNER_PHONE + VERIFICATION_SECTOR_PHONE acima). Diferente do token de usuário
# (AUTH_TOKEN_SECRET): quem chama aqui é o Bitrix, servidor a servidor, sem
# BX24.getAuth() nem sessão de navegador. Gerar com: node -e
# "console.log(require('crypto').randomBytes(32).toString('hex'))" — o
# MESMO valor precisa estar na URL configurada no Robô de Automação
# (?token=...). Sem esta variável, o endpoint responde 503 pra qualquer
# chamada (nunca fica aberto sem proteção por engano).
DEAL_GROUP_TRIGGER_TOKEN= — usada só pra mandar o
# e-mail de alerta quando uma instância de WhatsApp precisa de atenção
# (loggedOut/reconexão travada, ver src/email.js/src/emailAlert.js). Sem
# esta variável, o canal de e-mail fica silenciosamente inativo — os
# outros canais (in-app/push/WhatsApp de sistema) continuam funcionando
# normalmente (best-effort, independente).
RESEND_API_KEY=
# (Opcional) Remetente do e-mail acima — precisa ser de um domínio
# VERIFICADO na Resend (Settings > Domains, registros DNS SPF/DKIM). Sem
# domínio verificado, a Resend só aceita enviar a partir de
# onboarding@resend.dev (rate limit baixo, só serve pra teste). Padrão se
# vazio: onboarding@resend.dev.
EMAIL_FROM=

# --- Estabilidade/escala (2026-11-03, ver docs/arquitetura-workers.md) ---
# IA desligada por padrão (Agente, Copiloto, Dapinho, análises, reconhecimento
# de mídia). Pra religar: AI_FEATURES=true e OPENAI_API_KEY preenchida.
AI_FEATURES=
# Nº de processos que seguram as sessões do WhatsApp. 0/vazio = tudo num
# processo só (comportamento antigo). Sugestão: 2 numa VPS de 4 vCPU.
# SESSION_WORKERS=
# WORKER_HEAP_MB=
# lazy (padrão) = sessão sobe quando o dono abre o app; all = reconecta tudo no boot.
# SESSION_BOOT_MODE=
# SESSION_STAGGER_MS=
# PAIRING_MIN_GAP_MS=
# Reciclagem de worker antes de estourar o heap (ver docs/arquitetura-workers.md).
# Produção a partir de 2026-11-11: HARD_MB=2400, CONFIRM=2, SAMPLE_MS=15000.
# WORKER_RECYCLE_SOFT_MB=
# WORKER_RECYCLE_HARD_MB=
# WORKER_RECYCLE_CONFIRM=
# WORKER_MEM_SAMPLE_MS=
# Relatório de pilha quando um worker morre por falta de memória (padrão /tmp/node-reports).
# WORKER_REPORT_DIR=
# Diagnóstico de memória: mem-wN.log e perfil de alocação (heap-wN-*.txt) quando o heap passa de DIAG_HEAP_MB (padrão 1500, 0 desliga) e a cada +STEP_MB (700).
# WORKER_DIAG_DIR=
# WORKER_DIAG_HEAP_MB=
# WORKER_DIAG_STEP_MB=
# Histórico recente (RECENT) não é reprocessado quando a sessão já sincronizou; deixe vazio (ligado). "off" volta ao antigo e causa estouro de memória em religação em massa.
# HISTORY_SKIP_RECENT=
# Lista de transmissão (/campaign.html): por enquanto só o super admin cria/agenda; 0 libera pra todos.
# CAMPAIGN_ADMIN_ONLY=
# Máximo de destinatários por lista (padrão 100). Subir aumenta o risco de ban e de a lista parar num reinício.
# CAMPAIGN_MAX_RECIPIENTS=
# Lista de transmissão: se a instância cair no meio do envio, a lista pausa e retoma sozinha; passou deste tempo fora do ar (ms, padrão 1800000 = 30 min), o resto fica "não enviado".
# CAMPAIGN_OFFLINE_MAX_WAIT_MS=
