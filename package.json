{
  "name": "whatsapp-bitrix-gateway",
  "version": "1.0.0",
  "description": "Gateway que conecta uma sessão pessoal de WhatsApp (via QR Code) ao Bitrix24, expondo histórico, envio e stream em tempo real para a aba 'WhatsApp' do card do Negócio.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "pg": "^8.22.0",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@6.7.23": true,
    "protobufjs@7.6.4": true,
    "ffmpeg-static@5.3.0": true
  }
}
